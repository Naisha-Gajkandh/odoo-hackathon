# ─────────────────────────────────────────────────────────────────────────────
# TransitOps Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git (it's already in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Django Core ───────────────────────────────────────────────────────────────
# Generate a new secret key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY= "m+$2%q*2&_$mx25_6bn4m+m6)lsci$0=9$)nl8+9jige9&#fq9"

# Set to False in production
DJANGO_DEBUG=True

# Comma-separated list of allowed hosts
# Example: ALLOWED_HOSTS=localhost,127.0.0.1,transitops.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1


# ── Database ──────────────────────────────────────────────────────────────────
# Option A (default local dev): leave DATABASE_URL blank or commented out → SQLite is used automatically.
# Option B (Neon/Postgres): uncomment and paste your PostgreSQL connection string.
# DATABASE_URL=postgresql://neondb_owner:npg_xxxxxxx@ep-xxxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require


# ── Google OAuth (optional — only needed if using Google Sign-In) ─────────────
# Create a free OAuth Client ID at: https://console.cloud.google.com
#   APIs & Services → Credentials → Create → OAuth client ID → Web application
# Leave blank to disable the /api/auth/google/ endpoint.
GOOGLE_CLIENT_ID=


# ── CORS ──────────────────────────────────────────────────────────────────────
# Frontend dev server origin(s), comma-separated.
# Example: CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000


# ── Routing APIs (free, no key needed) ────────────────────────────────────────
# OSRM public demo server — real driving distance & duration between coordinates.
# No API key required. Rate limit: reasonable use (don't hammer it).
OSRM_BASE_URL=https://router.project-osrm.org

# Nominatim geocoding — converts location names ("Depot A") to lat/lon for OSRM.
# No API key required. Rate limit: 1 request/second (enforced in code).
# IMPORTANT: Set a descriptive User-Agent so Nominatim can identify your app.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=TransitOps-Hackathon/1.0


# ── Caching ───────────────────────────────────────────────────────────────────
# Leave blank for local in-memory cache (default).
# For Redis (multi-worker prod): REDIS_URL=redis://localhost:6379/1
REDIS_URL=
